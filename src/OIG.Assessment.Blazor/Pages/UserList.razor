@page "/users"

@using System.Net
@using OIG.Assessment.Application.Dtos
@using OIG.Assessment.Domain.Common
@inject UsersApiClient UsersApiClient
@inject CurrentUserState CurrentUserState
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<div class="row">
    <div class="col-md-3">
        <h5>Organizations</h5>
        <OrganizationNavigation SelectedOrganizationId="_selectedOrganizationId"
                                SelectedOrganizationIdChanged="OnOrganizationChanged" />
    </div>
    <div class="col-md-9">
        <div class="d-flex mb-3 align-items-end gap-2">
            <div class="flex-grow-1">
                <label class="form-label">Search by name</label>
                <input class="form-control" @bind="_searchName" @bind:event="oninput" />
            </div>
            <div class="mb-3">
                <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_isLoading">Search</button>
                <button class="btn btn-outline-secondary ms-2" @onclick="ClearOrganizationFilter" disabled="@_isLoading">
                    Clear org filter
                </button>
                @if (CanAddUser)
                {
                    <a class="btn btn-success ms-2" href="/users/new">Create user</a>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }
        else if (_isLoading)
        {
            <p>Loading users...</p>
        }
        else if (_users.Count == 0)
        {
            <p class="text-muted">No users found.</p>
        }
        else
        {
            <table class="table table-striped table-sm align-middle">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Organization</th>
                    <th>Roles</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in _users)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.OrganizationName</td>
                        <td>@string.Join(", ", user.RoleNames)</td>
                        <td>
                            <div class="btn-group" role="group">
                                @if (CanEditUser)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@($"/users/{user.Id}")">Edit</a>
                                }
                                @if (CanDeleteUser)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteUserAsync(user.Id, user.Name))" disabled="@_isLoading">Delete</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private Guid? _selectedOrganizationId;
    private string? _searchName;
    private bool _isLoading;
    private string? _error;
    private List<UserDto> _users = new();
    private HashSet<string> _permissions = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentUserState.Changed += OnCurrentUserChanged;
        await LoadPermissionsAsync();
        await SearchAsync();
    }

    private async void OnCurrentUserChanged()
    {
        await LoadPermissionsAsync();
        await SearchAsync();
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var (users, errorCode, errorMessage) = await UsersApiClient.SearchAsync(_searchName, _selectedOrganizationId);
            if (errorCode is HttpStatusCode.Unauthorized)
            {
                _users.Clear();
                _error = "Спочатку виберіть користувача у верхньому правому куті.";
            }
            else if (errorCode is HttpStatusCode.Forbidden)
            {
                _users.Clear();
                _error = "Обраний користувач не має прав для перегляду списку користувачів.";
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                _users.Clear();
                _error = errorMessage;
            }
            else
            {
                _users = users.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadPermissionsAsync()
    {
        if (!CurrentUserState.CurrentUserId.HasValue)
            return;

        var perms = await UsersApiClient.GetPermissionsAsync(CurrentUserState.CurrentUserId.Value);
        _permissions = perms.ToHashSet();
    }

    private bool CanAddUser => _permissions.Contains(Permissions.AddUser);
    private bool CanEditUser => _permissions.Contains(Permissions.EditUser);
    private bool CanDeleteUser => _permissions.Contains(Permissions.DeleteUser);

    private async Task OnOrganizationChanged(Guid? organizationId)
    {
        _selectedOrganizationId = organizationId;
        await SearchAsync();
    }

    private async Task ClearOrganizationFilter()
    {
        _selectedOrganizationId = null;
        await SearchAsync();
    }

    private async Task DeleteUserAsync(Guid userId, string userName)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to delete user '{userName}'?"))
            return;

        _isLoading = true;
        _error = null;
        try
        {
            var deleteError = await UsersApiClient.DeleteAsync(userId);
            if (!string.IsNullOrEmpty(deleteError))
            {
                _error = deleteError;
                return;
            }

            await SearchAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    public void Dispose()
    {
        CurrentUserState.Changed -= OnCurrentUserChanged;
    }
}

